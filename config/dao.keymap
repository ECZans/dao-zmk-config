#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    chosen {
        zmk,physical_layout = &dao_crkbd_layout;

        // zmk,physical_layout = &dao_full_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "MAIN";
            bindings = <
&kp LEFT_ALT      &kp Q  &kp D  &kp R  &kp W  &kp B      &kp J            &kp F       &kp U              &kp P      &mt GLOBE TAB  &kp ESCAPE
&kp LEFT_CONTROL  &kp A  &kp S  &kp H  &kp T  &kp G      &kp Y            &kp N       &kp E              &kp O      &kp I          &lt 3 QUESTION
&kp CAPSLOCK      &kp Z  &kp X  &kp M  &kp C  &kp V      &kp K            &kp L       &kp PERIOD         &kp COMMA  &kp SQT        &kp BACKSPACE
                                &mo 2  &mo 1  &kp SPACE  &kp RIGHT_SHIFT  &kp RETURN  &kp RIGHT_COMMAND
            >;
        };

        numbers-symbols {
            display-name = "NUM-SYM";
            bindings = <
&kp LEFT_ALT      &kp N0     &kp N1  &kp N2  &kp N3  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCL         &kp SLASH         &kp BACKSLASH  &kp TAB        &kp C_VOLUME_UP
&kp LEFT_CONTROL  &kp PLUS   &kp N4  &kp N5  &kp N6  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_SHIFT  &kp SEMICOLON     &kp GRAVE      &kp BACKSPACE  &kp C_VOLUME_DOWN
&kp CAPSLOCK      &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp MINUS        &kp PERIOD        &kp COMMA      &kp SQT        &kp K_MUTE
                                     &trans  &trans  &kp LEFT_SHIFT        &kp SPACE              &kp RETURN       &kp LEFT_COMMAND
            >;
        };

        mouse-media {
            bindings = <
&trans  &none  &kp DEL         &kp UP_ARROW      &kp INS     &kp PAGE_UP    &msc SCRL_UP       &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP
&trans  &none  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT   &kp PAGE_DOWN  &msc SCRL_DOWN     &mmv MOVE_LEFT  &mmv MOVE_UP     &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &kp C_VOLUME_DOWN
&trans  &none  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &none          &kp RIGHT_COMMAND  &none           &none            &none                 &none                 &kp K_MUTE
                               &trans            &trans      &trans         &mkp LCLK          &trans          &mkp RCLK
            >;
        };

        function {
            bindings = <
&kp F12  &kp F11  &kp F10  &kp F9  &kp F8  &kp F7  &none   &none   &none   &none  &none  &none
&kp F6   &kp F5   &kp F4   &kp F3  &kp F2  &kp F1  &none   &none   &none   &none  &none  &none
&none    &none    &none    &none   &none   &none   &none   &none   &none   &none  &none  &none
                           &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
