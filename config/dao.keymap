#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    chosen {
        zmk,physical_layout = &dao_crkbd_layout;

        // zmk,physical_layout = &dao_full_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&mt LEFT_ALT ESC  &kp Q  &kp D  &kp R           &kp W             &kp B        &kp J       &kp F     &kp U         &kp P    &kp SEMICOLON  &kp BACKSLASH
&mt LCTRL TAB     &kp A  &kp S  &kp H           &kp T             &kp G        &kp Y       &kp N     &kp E         &kp O    &kp I          &mt RCTRL SQT
&kp LEFT_SHIFT    &kp Z  &kp X  &kp M           &kp C             &kp V        &kp K       &kp L     &kp COMMA     &kp DOT  &kp FSLH       &mt RALT RIGHT_SHIFT
                                &lt 3 CAPSLOCK  &kp LEFT_COMMAND  &lt 1 SPACE  &kp RETURN  &kp BSPC  &lt 2 DELETE
            >;
        };

        numbers {
            display-name = "NUM";
            bindings = <
&mt LEFT_CONTROL ESCAPE  &kp GRAVE        &kp TILDE    &kp BACKSLASH  &kp MINUS   &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PLUS         &kp EQUAL
&mt LCTRL TAB            &kp N1           &kp N2       &kp N3         &kp N4      &kp N5          &kp N6                &kp N7                 &kp N8            &kp N9             &kp N0           &mt RCTRL RETURN
&kp LEFT_SHIFT           &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR  &kp PERCENT     &kp CARET             &kp AMPERSAND          &kp ASTERISK      &kp LEFT_BRACE     &kp RIGHT_BRACE  &kp RIGHT_SHIFT
                                                       &none          &none       &trans          &kp SPACE             &kp BACKSPACE          &kp DELETE
            >;
        };

        keypads {
            display-name = "PAD";
            bindings = <
&mt LGUI KP_NUM  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9      &kp KP_MINUS  &kp C_VOL_UP  &kp HOME  &kp PSCRN  &kp PG_UP  &kp SLCK         &kp CLCK
&mt LCTRL EQUAL  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6      &kp KP_PLUS   &kp C_MUTE    &kp LEFT  &kp UP     &kp RIGHT  &kp INS          &mt RCTRL K_APP
&kp LALT         &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3      &kp KP_DOT    &kp C_VOL_DN  &kp END   &kp DOWN   &kp PG_DN  &kp PAUSE_BREAK  &kp RALT
                                             &kp SPACE  &kp BACKSPACE  &kp RETURN    &none         &mo 4     &trans
            >;
        };

        functions {
            bindings = <
&kp ESCAPE      &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp DELETE
&kp TAB         &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &kp RET
&kp LEFT_SHIFT  &kp F21  &kp F22  &kp F23  &kp F24  &none    &none    &none    &none    &none    &none    &kp RIGHT_SHIFT
                                  &trans   &none    &none    &none    &none    &none
            >;

            label = "FN";
        };

        system {
            display-name = "SYS";
            bindings = <
&bootloader  &studio_unlock  &none         &none         &none         &none         &none         &none         &none         &none         &studio_unlock  &bootloader
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &bt BT_CLR
&sys_reset   &none           &none         &none         &none         &none         &none         &none         &none         &none         &none           &sys_reset
                                           &none         &none         &none         &none         &trans        &trans
            >;
        };
    };
};
